<?xml version="1.0" encoding="utf-8"?>
<!-- Back up settings only; recent-file URIs are device-specific grants. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
